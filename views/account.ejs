<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/styles.css">
    <title>Account | V-Bank</title>
</head>
<body>
    <%- include('header') %>
    
    <main>
        <section>
            <h1>Account Information</h1>
            <p><strong>Username:</strong> <%= user.user %></p>
            <p><strong>Account Number:</strong> <%= user.id %></p>
            <p><strong>Balance:</strong> $<%= user.balance.toFixed(2) %></p>
        </section>

        <section>
            <h1>Transfer Money</h1>
            <section>
                <form action="/transfer" method="POST">
                    <label for="recipient">Recipient Account Number:</label>
                    <input type="text" id="recipient" name="recipient" required>
                    
                    <label for="amount">Amount:</label>
                    <input type="number" id="amount" name="amount" step="0.01" required>
                    
                    <button type="submit">Transfer</button>
                </form>
            </section>
            <section>
                <h2>Recent Transactions</h2>
                <ul>
                    <% transactions.forEach(transaction => { %>
                        <li>
                            <strong><%= transaction.type %>:</strong> $<%= transaction.amount.toFixed(2) %> on <%= transaction.date.toLocaleDateString() %>
                        </li>
                    <% }) %>
                </ul>
            </section>
        </section>
    </main>

    <%- include('footer') %>
</body>
</html>