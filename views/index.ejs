<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/styles.css">
    <title>V-Banking</title>
</head>
<body>
    <%- include('header') %>

    <main>
        <section>
            <h2>Welcome to V-Banking</h2>
            <p>Welcome to our online banking service!</p>

            <% if (userLoggedInRN) { %>
                <p><a href="/logout">Logout</a></p>
            <% } else { %>
                <p><a href="/login">Login</a></p>
            <% } %>
        </section>

        <% if (userLoggedInRN) { %>
            <section>
                <h2>Your Account</h2>
                <% if (balance === Infinity) { %>
                    <p>Balance: <i>"How did we get here?"</i></p>
                <% } else { %>
                    <p>Balance: $<%= balance || 0 %></p>
                <% } %>
                <p><a href="/account">View Account Details</a></p>
            </section>
        <% } %>
    </main>

    <%- include('footer') %>
</body>
</html>
