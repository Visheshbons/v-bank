<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/styles.css">
    <title>Error <%- err.code %> | V-Bank</title>
</head>

<body>
    <%- include('header') %>

        <main>
            <section>
                <h1>Error <%- err.code %></h1>
                <% if (err.code === 404) { %>
                    <p>The page you are looking for does not exist.</p>
                <% } else if (err.code === 500) { %>
                    <p>Internal Server Error. Please try again later.</p>
                <% } else if (err.code === 501) { %>
                    <p>Not Implemented. The server does not support this functionality.</p>
                <% } else if (err.code === 502) { %>
                    <p>Bad Gateway. The server received an invalid response from an upstream server.</p>
                <% } else if (err.code === 503) { %>
                    <p>Service Unavailable. The server is temporarily unable to handle the request.</p>
                <% } else if (err.code === 504) { %>
                    <p>Gateway Timeout. The upstream server did not respond in time.</p>
                <% } else if (err.code === 505) { %>
                    <p>HTTP Version Not Supported. The server does not support the HTTP protocol version used in the request.</p>
                <% } else if (err.code === 506) { %>
                    <p>Variant Also Negotiates. The server has an internal configuration error.</p>
                <% } else if (err.code === 507) { %>
                    <p>Insufficient Storage. The server cannot store the representation needed to complete the request.</p>
                <% } else if (err.code === 508) { %>
                    <p>Loop Detected. The server detected an infinite loop while processing the request.</p>
                <% } else if (err.code === 510) { %>
                    <p>Not Extended. Further extensions to the request are required.</p>
                <% } else if (err.code === 511) { %>
                    <p>Network Authentication Required. The client must authenticate to gain network access.</p>
                <% } else { %>
                    <p>An unexpected error occurred.</p>
                <% } %>
                <p><a href="/">Return to homepage</a></p>
            </section>
        </main>

        <%- include('footer') %>
</body>

</html>